<?xml version="1.0" encoding="UTF-8"?>
<!--
  sitemap.xml — replace https://www.example.com/ with the real domain
  everywhere (here, in robots.txt and in the canonical/og:url tags).
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <url>
    <loc>https://www.example.com/</loc>
    <lastmod>2026-10-03</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="en-in" href="https://www.example.com/"/>
    <xhtml:link rel="alternate" hreflang="hi-in" href="https://www.example.com/hi/"/>
  </url>

  <url>
    <loc>https://www.example.com/about.html</loc>
    <lastmod>2026-10-03</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <url>
    <loc>https://www.example.com/contact.html</loc>
    <lastmod>2026-10-03</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>https://www.example.com/blog.html</loc>
    <lastmod>2026-10-03</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>

  <url>
    <loc>https://www.example.com/blog-post.html</loc>
    <lastmod>2026-10-03</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>

  <!--
    ADD ONE <url> BLOCK PER NEW BLOG POST as you publish, e.g.

    <url>
      <loc>https://www.example.com/how-to-choose-a-hostel-in-indore.html</loc>
      <lastmod>2026-10-10</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.6</priority>
    </url>
  -->
</urlset>
